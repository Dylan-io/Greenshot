# Configuration Supabase Greenshot
# Remplacer par l'URL et la clé anonyme fournies par le backend Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_publique_anon

# IA — fournisseur principal (recommandé) : https://console.groq.com/keys
# Qwen3.6-27B, vision, JSON mode. Offre gratuite : ~30 requêtes/min, 1000/jour
VITE_GROQ_API_KEY=gsk_votre_cle_groq

# IA — fournisseur de secours : https://aistudio.google.com/apikey
# Utilisé automatiquement si Groq échoue (quota, panne, clé absente)
VITE_GEMINI_API_KEY=votre_cle_gemini
